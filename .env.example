# 微信公众号配置
WECHAT_APP_ID=你的公众号 AppID
WECHAT_SECRET=你的公众号 Secret
WECHAT_TOKEN=你的微信服务器 Token
WECHAT_AES_KEY=你的消息加解密密钥（可选）

# JWT 配置（至少 32 个字符，建议使用随机字符串）
JWT_SECRET=your_jwt_secret_key_should_be_at_least_32_characters_long_for_security

# 数据库配置（Docker 模式下使用默认值）
# MYSQL_ROOT_PASSWORD=root123456
# MYSQL_DATABASE=wechat_auto_reply

# Redis 配置（Docker 模式下使用默认值）
# REDIS_HOST=redis
# REDIS_PORT=6379
